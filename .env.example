# Copy to backend/.env for running the API or tests outside Docker.
# Never commit a real .env file.

SIEVE_ENVIRONMENT=development
SIEVE_DATABASE_URL=postgresql+psycopg://sieve:sieve@127.0.0.1:5432/sieve
SIEVE_LOG_LEVEL=INFO
SIEVE_LOG_JSON=false

# Integration tests create and migrate this database themselves.
SIEVE_TEST_DATABASE_URL=postgresql+psycopg://sieve:sieve@127.0.0.1:5432/sieve_test
